# Vorlage fuer deploy/.env.deploy (lokal, wird von git ignoriert). Kopieren und anpassen:
#   cp deploy/.env.deploy.example deploy/.env.deploy
# Wird von scripts/deploy_pi.sh gelesen; gesetzte Umgebungsvariablen haben Vorrang.

# SSH-Ziel des Servers, auf dem Nodvard Deck laeuft (Benutzer@Adresse)
PI_HOST=admin@192.168.1.50

# Ordner relativ zum Home des Benutzers auf dem Ziel (Standard: lattice-deploy-test)
#DEPLOY_ROOT=lattice-deploy-test

# Optional: DNS-Resolver nur fuer den Nodvard-Deck-Container, z. B. ein lokaler Pi-hole,
# der interne Namen aufloest. Das Skript legt sie als deploy/.env auf dem Ziel ab
# (unter beiden Namen, neu und alt). Die alten Namen LATTICE_DNS_1/2 gelten weiter;
# sind beide gesetzt, gewinnt der neue.
#NODVARD_DECK_DNS_1=192.168.1.10
#NODVARD_DECK_DNS_2=1.1.1.1
