# Kopieren nach .env im Projekt-Root und nach Bedarf anpassen.
# Siehe docs/00-DECISIONS.md für die Begründung der Defaults.
#
# Alle Namen beginnen mit NODVARD_DECK_. Die früheren Namen mit LATTICE_ (z. B.
# LATTICE_ENV) gelten nur noch in dieser Version als Rückfall, ab 1.0 nicht mehr;
# steht beides da, gewinnt der neue Name.
# Beim Start meldet das Dashboard einmalig, welche alten Namen noch benutzt werden.

# Nur für die Entwicklung: `dev` macht die API-Doku ohne Anmeldung erreichbar. Ohne Angabe gilt `prod`.
NODVARD_DECK_ENV=dev
NODVARD_DECK_LOG_JSON=false

# Freiwillige Nutzungsdaten: ohne Adresse und Freigabe bleibt das Teilen gesperrt.
# Beispiel für eine spätere Empfängeradresse: https://telemetrie.example.invalid
NODVARD_DECK_TELEMETRY_URL=
NODVARD_DECK_TELEMETRY_PRIVACY_READY=false
NODVARD_DECK_TELEMETRY_INSTALLATION=sonstiges
# Administratorsperre: NODVARD_TELEMETRIE=aus (auch im Container setzen).

# Alles Zustandsbehaftete (SQLite-Datei, Master-Key, später Extension-Daten und
# Run-Logs) lebt hier. Relative Pfade werden gegen das Arbeitsverzeichnis aufgelöst --
# Konvention in diesem Projekt: alle Befehle (uvicorn, alembic, pytest) laufen aus dem
# Repository-Root (nicht aus backend/).
NODVARD_DECK_DATA_DIR=./data

# SQLite ist der Default (D-02). Für Postgres: postgresql+asyncpg://<benutzer>:<passwort>@host/db
NODVARD_DECK_DATABASE_URL=sqlite+aiosqlite:///./data/lattice.db

NODVARD_DECK_MASTER_KEY_PATH=./data/master.key
NODVARD_DECK_VAULT_KEYRING_PATH=./data/vault_keyring.json

# Aufbewahrung des Protokolls in Tagen. Rückfall: gilt, solange unter Einstellungen,
# System nichts eingestellt ist (Schlüssel `audit.retention_days`, 7 bis 3650).
NODVARD_DECK_AUDIT_RETENTION_DAYS=90

# Zeitzone für Zeitpläne und Wartungsfenster, z. B. Europe/Berlin. Vorgabe, solange unter
# Einstellungen, System nichts eingestellt ist (`system.timezone`). Leer = `TZ`, sonst Europe/Berlin.
# NODVARD_DECK_TIMEZONE=Europe/Berlin

# Leer lassen: wird beim ersten Start als Zufallswert in NODVARD_DECK_JWT_SECRET_PATH
# geschrieben. Nur in Docker/K8s explizit setzen (Secret-Mount).
# NODVARD_DECK_JWT_SECRET=  (auskommentiert lassen: ein leerer Wert würde einen alten LATTICE_JWT_SECRET überstimmen)
NODVARD_DECK_JWT_SECRET_PATH=./data/jwt_secret.key

NODVARD_DECK_ACCESS_TOKEN_TTL_SECONDS=900
NODVARD_DECK_REFRESH_TOKEN_TTL_DAYS=30
NODVARD_DECK_MFA_TOKEN_TTL_SECONDS=300

# Fake-Daten statt echter Connectoren -- für das herunterladbare Test-Image (D-10).
NODVARD_DECK_DEMO_MODE=false
